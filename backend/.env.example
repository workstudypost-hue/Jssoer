# ============ التطبيق ============
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ============ قاعدة البيانات ============
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edu_platform?schema=public"
# اختياري لاحقًا: نسخة القراءة فقط للتقارير
DATABASE_REPLICA_URL="postgresql://postgres:postgres@localhost:5433/edu_platform?schema=public"

# ============ Redis (جلسات، Rate limiting، BullMQ) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============ JWT ============
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=7

# ============ قيد الأجهزة ============
MAX_ACTIVE_DEVICES_PER_USER=1

# ============ OTP ============
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ============ OAuth ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/public/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:4000/api/v1/auth/public/microsoft/callback
MICROSOFT_TENANT=common

# ============ مزودو الإشعارات (Email/SMS/WhatsApp) ============
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@workstudy.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=
TWILIO_WHATSAPP_FROM_NUMBER=

# ============ Object Storage (S3/R2) ============
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_UPLOADS=raw-uploads
STORAGE_BUCKET_REPORTS=generated-reports

# ============ بوابات الدفع ============
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
TABBY_ENV=sandbox
TABBY_API_KEY=
TABBY_PUBLIC_KEY=
TABBY_MERCHANT_CODE=
TAMARA_ENV=sandbox
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
OPEN_EXCHANGE_RATES_APP_ID=

# ============ حماية الفيديو ============
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# ============ الذكاء الاصطناعي ============
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# ============ تصدير التقارير (PDF) ============
# مسار Chrome/Chromium المثبَّت على مستوى النظام - مطلوب فقط لتصدير PDF.
# التثبيت على Ubuntu/Debian: apt-get install -y chromium
# اترك فارغًا محليًا إن كان Chrome مثبَّتًا في مسار قياسي - Puppeteer سيجده تلقائيًا.
PUPPETEER_EXECUTABLE_PATH=

